{
  "name": "agra-platform",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Nucleo e API do AGRA para gestao rural sustentavel.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "node scripts/build.mjs",
    "build:all": "npm run build",
    "desktop:dev": "npm run build:all && electron .",
    "desktop:win": "npm run build:all && electron-builder --win portable",
    "embrapa:normalize": "node scripts/ingest-embrapa.mjs data/embrapa/catalog.example.json normalize",
    "embrapa:download": "node scripts/ingest-embrapa.mjs data/embrapa/catalog.normalized.json download",
    "start": "node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "br.com.agra.desktop",
    "productName": "AGRA",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "dist/web/**/*",
      "dist/server.js",
      "dist/domain/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
