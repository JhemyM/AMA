{
  "name": "agra-platform",
  "private": true,
  "version": "0.3.4",
  "description": "Nucleo do AGRA para gestao rural sustentavel.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JhemyM/AMA.git"
  },
  "author": "JhemyM",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JhemyM/AMA/issues"
  },
  "homepage": "https://jhemym.github.io/AMA",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "node scripts/build.mjs",
    "build:all": "npm run build",
    "desktop:dev": "npm run build:all && electron .",
    "desktop:win": "npm run build:all && electron-builder --win portable"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "br.com.agra.desktop",
    "productName": "AGRA",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "dist/web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
